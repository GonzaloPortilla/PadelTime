{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "padel-time",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    // Binding para que el Worker sirva el panel (/admin) y archivos de la raíz.
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // El Worker atiende la web pública, la API y el panel. Los archivos estáticos se sirven directo
    // (gratis e ilimitados): no consumen las 100.000 requests/día del plan Free.
    "run_worker_first": ["/*", "!/assets/*", "!/pub/*", "!/brand/*", "!/web/*", "!/ocr/*", "!/manifest.webmanifest", "!/favicon.svg",
      // Rutas internas del servidor de desarrollo de Vite (no existen en producción).
      "!/@vite/*", "!/@react-refresh", "!/@id/*", "!/@fs/*", "!/src/*", "!/node_modules/*", "!/shared/*"]
  },

  // Archivos de la web (imágenes y PDF): Workers KV, gratis hasta 1 GB y sin tarjeta.
  // Reemplazar por el ID que devuelve `npx wrangler kv namespace create MEDIA`.
  "kv_namespaces": [{ "binding": "MEDIA", "id": "00000000000000000000000000000000" }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "padel-time",
      // Reemplazar por el ID que devuelve `npx wrangler d1 create padel-time`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Días de validez de una sesión sin actividad.
    "SESSION_TTL_DAYS": "30",
    // Iteraciones PBKDF2-SHA256 para hashes nuevos. 30000 ≈ 6 ms de CPU: entra en el límite
    // de 10 ms/request del plan Free. Con plan pago puede subirse hasta 100000 (máximo de Workers).
    "PBKDF2_ITERATIONS": "30000",
    // Sitios autorizados a incrustar las páginas públicas (/publico) en un iframe.
    // Google Sites sirve el contenido incrustado desde sites.google.com y *.googleusercontent.com.
    "PUBLIC_FRAME_ANCESTORS": "https://sites.google.com https://*.googleusercontent.com https://www.padeltime.com.ar https://padeltime.com.ar",
    // "produccion" o "prueba". En "prueba" la web muestra una franja de entorno de prueba y no se indexa.
    "ENVIRONMENT": "produccion"
  },
  // Limpieza diaria de sesiones vencidas (06:17 UTC = 03:17 en Argentina). Gratis: hasta 5 cron por cuenta.
  "triggers": { "crons": ["17 6 * * *"] },
  "observability": { "enabled": true },

  // Dominio oficial (Fase 11). NO está activo: se habilita recién cuando se autorice el lanzamiento
  // (ver docs/DOMINIO.md). Con dominio propio, Cloudflare emite y renueva el certificado HTTPS solo.
  // "routes": [
  //   { "pattern": "padeltime.com.ar", "custom_domain": true },
  //   { "pattern": "www.padeltime.com.ar", "custom_domain": true }
  // ],

  // ── Entorno de prueba independiente ──────────────────────────────────────────────────────────
  // Mismo código, otro Worker (padel-time-prueba.<subdominio>.workers.dev), otra base y otro espacio de
  // archivos: los datos de demostración nunca se mezclan con los reales. No se indexa en buscadores.
  //   npm run deploy:prueba   ·   npm run db:seed:prueba
  "env": {
    "prueba": {
      "name": "padel-time-prueba",
      "kv_namespaces": [{ "binding": "MEDIA", "id": "e031f59037e94bfebdb2242e96b1f764" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "padel-time-prueba",
          // Reemplazar por el ID que devuelve `npx wrangler d1 create padel-time-prueba`.
          "database_id": "d79ae255-fa9a-4281-8e07-295e1f38bfc7",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "SESSION_TTL_DAYS": "7",
        "PBKDF2_ITERATIONS": "30000",
        "PUBLIC_FRAME_ANCESTORS": "'none'",
        "ENVIRONMENT": "prueba"
      },
      "triggers": { "crons": ["17 6 * * *"] }
    }
  }
}
